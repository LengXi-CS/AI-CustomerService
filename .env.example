# 首次部署：在项目根目录执行 Copy-Item .env.example .env，再填写本机配置。
# .env 已被 Git 忽略；请勿提交真实密钥、Token 或业务实例标识。
# 环境变量优先于 .env；修改后需重启服务。群策略由 config/wechat_groups.toml 管理。
# 使用当前规范字段名；历史 EA_*、DEEPSEEK_* 等别名仍兼容，无需重复填写。

# --- 应用与管理后台 ---
# 使用 uvicorn 时，监听地址与端口以命令行 --host / --port 为准。
APP_HOST=0.0.0.0
APP_PORT=5330
LOG_LEVEL=INFO
ADMIN_AUTH_PATH=data/admin/auth.json
# 可选：允许通过 HTTP 登录后台的局域网网段，多个 CIDR 用英文逗号分隔。
# 留空时不额外放行局域网 HTTP；本机初始化密码：uv run python scripts/setup_admin.py
ADMIN_LAN_HTTP_NETWORKS=

# --- 对话与图片模型（OpenAI 兼容接口）---
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# 留空时图片请求使用主模型；请确认所选模型支持图片输入。
LLM_VISION_MODEL=

# --- FastGPT 知识库 ---
# 填写自己的 FastGPT 服务地址、API Key 和知识库 ID。
FASTGPT_API_URL=http://localhost:3001
FASTGPT_API_KEY=
FASTGPT_DATASET_ID=
# 可选兼容凭证：仅在未填写 FASTGPT_API_KEY 且确有需要时配置。
FASTGPT_ROOT_KEY=

# --- GeWe 微信接入 ---
GEWE_API_URL=http://api.geweapi.com
GEWE_TOKEN=
GEWE_APP_ID=
# 本机示例；接入 GeWe 时改为实际可从公网访问的回调地址，并在 GeWe 注册。
GEWE_CALLBACK_URL=http://127.0.0.1:5330/api/wechat/callback
# 媒体外链的公网根地址（不带末尾斜杠），例如 https://callback.example.com。
# 留空则从 GEWE_CALLBACK_URL 推导；公网接入时必须确认媒体地址可达。
GEWE_PUBLIC_BASE_URL=
WECHAT_GROUPS_CONFIG_PATH=config/wechat_groups.toml

# --- 飞书多维表格（使用同步功能时填写）---
LARK_APP_ID=
LARK_APP_SECRET=
LARK_BITABLE_APP_TOKEN=

# --- 本地存储 ---
SQLITE_DB_PATH=data/read-model.db
MEDIA_STORE_DIR=data/resources/attachments
CONVERSATION_STATE_DB_PATH=data/conversation-state.db
CHAT_LOG_ENABLED=true
CHAT_LOG_DB_PATH=data/chat-log.db
VAULT_STORAGE_DIR=data/vault
# 必填：首次运行前替换为本机生成的随机密钥，并持久保存、备份。
# 生成示例：uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# 已有保险库时沿用原密钥；更换会导致已有加密载荷无法解密。
VAULT_SECRET_KEY=replace-with-a-locally-generated-random-secret

# --- 回复节奏与路由 ---
# 静默窗口为群未配置独立等待时间时的默认值（秒）。
CONVERSATION_QUIET_WINDOW_SECONDS=120
CONVERSATION_POLL_INTERVAL_SECONDS=30
ATTACHMENT_DISPATCH_INTERVAL_SECONDS=5.0
# 满足 0 <= HUMAN <= NORMAL <= 1。
ROUTING_NORMAL_CONFIDENCE_THRESHOLD=0.80
ROUTING_HUMAN_CONFIDENCE_THRESHOLD=0.50
OWNER_NOTIFY_ENABLED=true
