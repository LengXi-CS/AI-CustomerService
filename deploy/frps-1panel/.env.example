# 用法：cp .env.example .env，然后按注释修改（这个文件含密钥，别提交到 git）
# 生成强随机值：  openssl rand -hex 32

# 【必填】客户端准入密钥。C 端 frpc.toml 的 auth.token 必须与本值完全一致。
FRP_TOKEN=请替换为_openssl_rand_hex_32_的输出

# Dashboard 登录账号密码（Dashboard 只监听 127.0.0.1，公网访问不到）
FRP_DASHBOARD_USER=admin
FRP_DASHBOARD_PWD=请替换为高强度密码

# 时区
TZ=Asia/Shanghai
